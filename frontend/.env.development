# Defaults for `npm run dev`. Committed on purpose: nothing here is a secret,
# and it lets the project run right after `git clone` with no setup.
#
# Server-only: read by Server Components and Server Actions (lib/queue-api.ts).
# Without the NEXT_PUBLIC_ prefix it is never sent to the browser.
#
# To use another value locally, put it in .env.development.local (git-ignored).
# E2E tests (Step 8) and Docker (Step 9) pass their own value as an environment variable.
API_BASE_URL=http://localhost:5080

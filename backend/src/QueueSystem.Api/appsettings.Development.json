{
  // DEVELOPMENT ONLY. This password is committed on purpose and is not a secret.
  // It belongs to the local SQL Server container in docker-compose.yml: this is a
  // job-application test project, the container listens on 127.0.0.1 only and holds
  // no real data. See the note at the top of docker-compose.yml.
  // A real deployment would read the connection string from the environment or a
  // secret store and would not use the sa login.
  // To override it without editing this file, use dotnet user-secrets or the
  // ConnectionStrings__QueueDb environment variable (both take precedence).
  //
  // 127.0.0.1, not localhost: on Windows "localhost" resolves to ::1 (IPv6) first,
  // but the container port is published on 127.0.0.1 only, so the client times out.
  "ConnectionStrings": {
    "QueueDb": "Server=127.0.0.1,1433;Database=QueueSystem;User Id=sa;Password=LocalDev_Passw0rd!;TrustServerCertificate=True"
  },
  // Create or upgrade the schema when the API starts, so `dotnet run` works on a fresh clone.
  "Database": {
    "MigrateOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
